{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "clickshot",
  "version": "0.0.1",
  "identifier": "com.nishu.clickshot",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "/tmp/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "msi",
      "nsis",
      "app",
      "dmg",
      "rpm"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "icon": [
      "icons/128x128.png"
    ],
    "linux": {
      "appimage": {
        "files": {
          "/usr/share/README.md": "../README.md",
          "/usr/assets": "../dist/assets/"
        }
      }
    }
  }
}
